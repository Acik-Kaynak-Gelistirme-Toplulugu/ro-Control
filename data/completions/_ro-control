#compdef ro-control

local -a commands
commands=(
  'help:Show usage information'
  'version:Show application version'
  'status:Show concise system and driver status'
  'diagnostics:Show full diagnostics snapshot'
  'driver:Manage NVIDIA drivers'
  'fan:Manage cooling and fan profiles'
)

local -a driver_commands
driver_commands=(
  'install:Install the NVIDIA driver'
  'remove:Remove installed NVIDIA packages'
  'update:Update the installed NVIDIA driver'
  'deep-clean:Remove legacy NVIDIA leftovers'
)

local -a fan_commands
fan_commands=(
  'status:Show fan status'
  'set-speed:Set fan speed percentage'
  'set-mode:Set fan operating mode profile'
  'reset:Restore default automatic fan profile'
)

local -a fan_modes
fan_modes=(
  'auto:Default hardware curve'
  'silent:Acoustic priority'
  'balanced:Thermal-acoustic equilibrium'
  'performance:Maximum airflow cooling'
  'manual:Fixed speed percentage'
  'custom:Custom temperature curve'
)

local -a global_opts
global_opts=(
  '--help[Show usage information]'
  '--version[Show application version]'
  '--diagnostics[Legacy alias for diagnostics]'
  '--json[Render status or diagnostics output as JSON]'
)

local -a install_opts
install_opts=(
  '--proprietary[Use the proprietary NVIDIA driver install path]'
  '--open-source[Use the community open-source graphics path]'
  '--accept-license[Confirm NVIDIA license review for the proprietary install path]'
)

if (( CURRENT == 2 )); then
  _describe 'command' commands
  _describe 'option' global_opts
  return
fi

case "${words[2]}" in
  status|diagnostics)
    _describe 'option' '--json[Render output as JSON]'
    ;;
  driver)
    if (( CURRENT == 3 )); then
      _describe 'driver-command' driver_commands
      return
    fi

    if [[ "${words[3]}" == "install" ]]; then
      _describe 'install-option' install_opts
    fi
    ;;
  fan)
    if (( CURRENT == 3 )); then
      _describe 'fan-command' fan_commands
      return
    fi

    if [[ "${words[3]}" == "status" ]]; then
      _describe 'option' '--json[Render fan status as JSON]'
    elif [[ "${words[3]}" == "set-mode" ]]; then
      _describe 'fan-mode' fan_modes
    fi
    ;;
  *)
    _describe 'option' global_opts
    ;;
esac
