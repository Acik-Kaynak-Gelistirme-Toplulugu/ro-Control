# Maintainer: Project-Ro-ASD <https://github.com/Project-Ro-ASD>
# Contributor: Emir <emir@project-ro-asd.org>

pkgname=ro-control
pkgver=1.3.0
pkgrel=1
pkgdesc="Native Qt6 / QML NVIDIA driver manager, hardware telemetry, and fan cooling suite"
arch=('x86_64' 'aarch64')
url="https://github.com/Project-Ro-ASD/ro-Control"
license=('GPL3')
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-quickcontrols2'
    'polkit'
    'pciutils'
    'kmod'
    'lm_sensors'
    'hicolor-icon-theme'
)
makedepends=(
    'cmake'
    'ninja'
    'gcc'
    'qt6-tools'
    'extra-cmake-modules'
)
optdepends=(
    'nvidia-utils: Proprietary NVIDIA driver support and NVML telemetry'
    'nvidia-settings: Fan speed and clock offset overrides under X11'
    'mokutil: Secure Boot key verification'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -S "$pkgname-$pkgver" \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DBUILD_TESTS=ON

    cmake --build build --parallel
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
